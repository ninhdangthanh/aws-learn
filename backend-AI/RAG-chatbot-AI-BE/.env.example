APP_NAME=rag-chatbot-ai-backend
APP_HOST=0.0.0.0
APP_PORT=8099
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s
APP_SHUTDOWN_TIMEOUT=10s

UPLOAD_DIR=storage/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
CHUNK_SIZE=500
CHUNK_OVERLAP=100
ASYNQ_QUEUE_NAME=default
ASYNQ_CONCURRENCY=10

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragchat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/ragchat?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4.1-mini
