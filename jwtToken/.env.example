APP_PORT=8080
APP_ENV=development

# Postgres chạy ở 5433 (xem docker-compose.yml)
DB_DSN=postgres://jwtuser:jwtpass@localhost:5433/jwtauth?sslmode=disable

REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# Bắt buộc, tối thiểu 32 ký tự. Sinh mới: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=jwt-auth

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

CORS_ORIGINS=http://localhost:5173
