# Copy sang .env nếu muốn override. Default đã khớp docker-compose.
PORT=:8090
DATABASE_URL=postgres://app:app@localhost:5433/shop?sslmode=disable
ES_URL=http://localhost:9200
ES_ALIAS=products
# outbox = đáng tin (worker sync). dual = demo lỗi dual-write (worker tắt).
WRITE_MODE=outbox
WORKER_POLL=1s
RUN_WORKER=true
CORS_ORIGIN=http://localhost:5173
