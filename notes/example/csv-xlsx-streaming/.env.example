# Copy sang .env rồi chỉnh cho khớp Postgres của bạn
DATABASE_URL=postgres://postgres:postgres@localhost:5432/streaming_demo

# Kích thước file fake muốn tạo (đơn vị: GB). Ví dụ 1 = ~1GB
FAKE_TARGET_GB=1

# Số dòng insert mỗi batch khi import (batch quá lớn -> tốn RAM, quá nhỏ -> chậm)
IMPORT_BATCH_SIZE=5000

# Tên file dùng chung cho các script
CSV_FILE=./data/users.csv
EXPORT_CSV_FILE=./data/export.csv
EXPORT_XLSX_FILE=./data/export.xlsx
