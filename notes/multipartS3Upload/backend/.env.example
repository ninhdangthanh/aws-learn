# Copy to .env and fill in. Credentials come from the standard AWS chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, ~/.aws/credentials,
# or an attached IAM role) — do NOT hardcode them here in production.
PORT=:8001
AWS_REGION=ap-southeast-1
S3_BUCKET=my-upload-bucket-multi-part
S3_KEY_PREFIX=uploads/
PART_SIZE_BYTES=10485760
PRESIGN_EXPIRY_SECONDS=900
CORS_ORIGIN=http://localhost:5173

# Local dev only — prefer roles/SSO in real environments:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
