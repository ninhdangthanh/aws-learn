{
    "family": "videocall-task",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "backend",
            "image": "<IMAGE_BE>",
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "PORT",
                    "value": "8080"
                },
                {
                    "name": "DB_PATH",
                    "value": "/app/videocall.db"
                }
            ],
            "secrets": [
                {
                    "name": "JWT_SECRET",
                    "valueFrom": "arn:aws:ssm:ap-southeast-1:677402243468:parameter/videocall/JWT_SECRET"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/videocall",
                    "awslogs-region": "ap-southeast-1",
                    "awslogs-stream-prefix": "backend"
                }
            }
        },
        {
            "name": "frontend",
            "image": "<IMAGE_FE>",
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "dependsOn": [
                {
                    "containerName": "backend",
                    "condition": "START"
                }
            ],
            "environment": [
                {
                    "name": "BACKEND_URL",
                    "value": "http://localhost:8080"
                },
                {
                    "name": "API_URL",
                    "value": ""
                },
                {
                    "name": "WS_URL",
                    "value": ""
                },
                {
                    "name": "STUN_URLS",
                    "value": "stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302"
                },
                {
                    "name": "ICE_TRANSPORT_POLICY",
                    "value": "all"
                }
            ],
            "secrets": [
                {
                    "name": "TURN_URLS",
                    "valueFrom": "arn:aws:ssm:ap-southeast-1:677402243468:parameter/videocall/TURN_URLS"
                },
                {
                    "name": "TURN_USERNAME",
                    "valueFrom": "arn:aws:ssm:ap-southeast-1:677402243468:parameter/videocall/TURN_USERNAME"
                },
                {
                    "name": "TURN_CREDENTIAL",
                    "valueFrom": "arn:aws:ssm:ap-southeast-1:677402243468:parameter/videocall/TURN_CREDENTIAL"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/videocall",
                    "awslogs-region": "ap-southeast-1",
                    "awslogs-stream-prefix": "frontend"
                }
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "executionRoleArn": "arn:aws:iam::677402243468:role/ecsTaskExecutionRole"
}
